################################################
# evryCore playerbots module                   #
################################################
[worldserver]

#
#    Playerbots.Enable
#        Description: Create and log in in-process playerbots on world startup.
#                     Bots are real characters in the characters database.
#                     They send the same client packets a person sends.
#        Default:     0 (disabled)
#
#                     1 - enabled
#                     0 - disabled
#

Playerbots.Enable = 0

#
#    Playerbots.Count
#        Description: How many bots to keep online. Start at 1.
#                     Each online bot has its own Battlenet account and one game account.
#                     Existing bot characters are loaded on restart; they are not wiped.
#        Default:     1
#

Playerbots.Count = 1

#
#    Playerbots.RegenerateCharacters
#        Description: On the next worldserver start, delete every character on
#                     PLAYERBOTn@PLAYERBOTS.LOCAL through the same path as a
#                     character-list delete. Battlenet accounts are kept.
#                     That boot does not create or log in bots. The process then
#                     stops. Set this back to 0 before the next start, or the
#                     new bots will be wiped again.
#        Default:     0
#
#                     1 - wipe bot characters and stop
#                     0 - leave existing bot characters
#

Playerbots.RegenerateCharacters = 0

#
#    Appender.Playerbots
#        Description: File for module.playerbots log lines. Lives under LogsDir
#                     next to Server.log. Type 2 = file, level 3 = Info, flags 3 =
#                     timestamp and log level on each line, mode a = append.
#                     Does not replace Appender.Console. Do not put this in
#                     worldserver.conf; Log::Initialize reads every Appender.*
#                     key after module conf is loaded.
#        Default:     2,3,3,Playerbots.log,a
#

Appender.Playerbots = 2,3,3,Playerbots.log,a

#
#    Logger.module.playerbots
#        Description: What the module already logs as "module.playerbots".
#                     Level 3 = Info. Appender list is Console (the existing
#                     worldserver terminal) and Playerbots (the file above).
#                     Lines do not go to Server.log unless you add Server here.
#        Default:     3,Console Playerbots
#

Logger.module.playerbots = 3,Console Playerbots
