################################################
# evryCore playerbots module                   #
################################################
[worldserver]

#
#    Playerbots.Enable
#        Description: Discover or create the configured in-process playerbot roster.
#                     Playerbots.LoginMode decides when they log in.
#                     Bots are real characters in the characters database.
#                     They send the same client packets a person sends.
#        Default:     0 (disabled)
#
#                     1 - enabled
#                     0 - disabled
#

Playerbots.Enable = 0

#
#    Playerbots.LoginMode
#        Description: Who asks worldserver to start the configured bot sessions.
#                     Worldserver always constructs the sessions and performs
#                     the normal bot login sequence on its world thread.
#        Default:     Automatic
#
#                     Automatic   - log in the roster during world startup
#                     Coordinator - create the roster but leave it offline until
#                                   playerbots.exe connects and requests it online.
#                                   If that owning connection remains gone for five
#                                   seconds, save and log out the bots in place.
#
#                     If something else ends a bot session, such as a GM kick
#                     or an AntiDOS kick, Playerbots.log says so and the bot
#                     logs in again after 30 seconds. In Coordinator mode that
#                     happens only while playerbots.exe owns the roster.
#                     Like a player, a bot does not log in while its account
#                     or character is banned, while the world is closed, or
#                     while the realm only admits accounts above player
#                     security.
#

Playerbots.LoginMode = Automatic

#
#    Playerbots.Count
#        Description: How many bots belong to the configured roster. Start at 1.
#                     Each bot has its own Battlenet account and one game account.
#                     Existing bot characters are loaded on restart; they are not wiped.
#        Default:     1
#

Playerbots.Count = 1

#
#    Playerbots.Races
#        Description: Comma-separated English race names for new bot characters.
#                     Empty means every race the switches below allow.
#                     Names match the character create screen (Tauren, Orc, Blood Elf).
#                     Spaces and capitalization do not matter. Only used when a new
#                     bot character is created. Existing bots are not changed.
#                     A name the switches below exclude is skipped and logged with
#                     the switch that excluded it. If nothing legal remains, no
#                     character is created and one error names every key involved.
#        Default:     "" (no filter)
#
#        Example:     Tauren
#                     Tauren, Orc
#

Playerbots.Races =

#
#    Playerbots.Classes
#        Description: Comma-separated English class names for new bot characters.
#                     Empty means every class the switches below allow.
#                     Names match the character create screen (Warrior, Hunter, Shaman).
#                     Spaces and capitalization do not matter. Only used when a new
#                     bot character is created. Existing bots are not changed.
#                     A name the switches below exclude (Death Knight, Demon Hunter,
#                     Evoker, Hero, Reaper) is skipped and logged with the switch
#                     that excluded it. Adventurer and Traveler are never made. If
#                     the race and class lists have no legal combo, no character is
#                     created.
#        Default:     "" (no filter)
#
#        Example:     Warrior
#                     Warrior, Hunter
#

Playerbots.Classes =

#
#    Playerbots.Horde
#    Playerbots.Alliance
#    Playerbots.AlliedRaces
#    Playerbots.Dracthyr
#    Playerbots.DeathKnight
#    Playerbots.DemonHunter
#    Playerbots.Evoker
#    Playerbots.HeroClass
#    Playerbots.CoAClasses
#    Playerbots.Pandaren
#        Description: Which new bot characters may be made. Each switch is 1 (on)
#                     or 0 (off). A bot is made only when every switch she needs is
#                     on, Playerbots.Races and Playerbots.Classes allow her, and she
#                     passes the same create checks a player gets, including
#                     CharacterCreating.Disabled, CharacterCreating.MinLevelForDemonHunter,
#                     CharacterCreating.MinLevelForEvoker and
#                     CharacterCreating.EvokersPerRealm. A Dracthyr Evoker needs
#                     Dracthyr, Evoker and the switch for her faction.
#                     Horde         - Horde races.
#                     Alliance      - Alliance races.
#                     AlliedRaces   - every race the game marks as an allied race.
#                     Dracthyr      - Dracthyr (not part of AlliedRaces).
#                     DeathKnight   - the Death Knight class.
#                     DemonHunter   - the Demon Hunter class.
#                     Evoker        - the Evoker class.
#                     HeroClass     - evryCore's custom Hero class (needs mod-hero).
#                     CoAClasses    - every Conquest of Azeroth class, Reaper today
#                                     (needs mod-coa).
#                     Pandaren      - Pandaren. A Pandaren bot starts as a neutral
#                                     Pandaren on the Wandering Isle and chooses
#                                     the Horde or the Alliance at its end by
#                                     HordePercent and the Horde and Alliance
#                                     switches, as a player does; she is never
#                                     made as a Horde or Alliance Pandaren. The
#                                     bot brain cannot yet do most of the
#                                     Wandering Isle's quests (balance poles,
#                                     clicking a spirit or a cart, the balloon,
#                                     escorts), so a Pandaren bot will probably
#                                     stop partway; Playerbots.log says so once
#                                     when this is 1.
#                     Ordinary races and classes (Goblin, Worgen, Monk and the rest)
#                     come with their faction.
#                     Only Horde has passed its playtest so far; Pandaren may be
#                     turned on anyway. Any other switch turned on makes no bots and
#                     says so once in Playerbots.log.
#                     With Horde and Alliance both 0, no new bot is made; one error
#                     names both keys and existing bots still log in.
#                     Read when a new bot character is created. Turning a switch off
#                     never deletes, logs out or changes a bot that already exists;
#                     to replace the bots use Playerbots.DeleteBots.
#        Default:     Playerbots.Horde = 1, every other switch 0
#

Playerbots.Horde = 1
Playerbots.Alliance = 0
Playerbots.AlliedRaces = 0
Playerbots.Dracthyr = 0
Playerbots.DeathKnight = 0
Playerbots.DemonHunter = 0
Playerbots.Evoker = 0
Playerbots.HeroClass = 0
Playerbots.CoAClasses = 0
Playerbots.Pandaren = 0

#
#    Playerbots.HordePercent
#        Description: The share of bot characters, 0 to 100, that should be Horde
#                     when both Playerbots.Horde and Playerbots.Alliance can make
#                     bots; the rest are Alliance. Each new bot goes to the faction
#                     furthest below its share, counting the bots that already
#                     exist, so the whole roster moves toward this split. Existing
#                     bots are never changed to reach it. Ignored when only one
#                     faction can make bots. A value outside 0 to 100 is clamped and
#                     logged once.
#        Default:     50
#

Playerbots.HordePercent = 50

#
#    Playerbots.DeleteBots
#        Description: On the next worldserver start, delete every bot: each
#                     character on a PLAYERBOTn@PLAYERBOTS.LOCAL Battle.net
#                     account (through the same path as a character-list
#                     delete), then the bot game accounts, then the bot
#                     Battle.net accounts and their collections. Only an email of
#                     exactly that shape counts as a bot. Mail a human sent a bot
#                     goes back to the human with its items and money; a guild a
#                     bot leads passes to the highest-ranked member left. A bot's
#                     auction stays up and ends as auctions do.
#                     That boot does not create or log in bots. It waits until the
#                     database shows every delete done, then stops. Set this back
#                     to 0 and start again: new bots are made from Count, Races
#                     and Classes at that time. Left at 1, every start wipes.
#        Default:     0
#
#                     1 - wipe all bots and bot accounts, then stop
#                     0 - leave existing bot characters
#

Playerbots.DeleteBots = 0

#
#    Playerbots.InvitePolicy
#        Description: Who a bot accepts a party invite from. She answers the invite
#                     window after a moment, like a player, with the same accept or
#                     decline a client sends. The server's own rules still apply
#                     first (faction, ignore list, full party, and the rest).
#                     Each choice also accepts everyone the one above it accepts,
#                     so a game master is always accepted unless it is Nobody.
#        Default:     GameMaster
#
#                     Nobody     - decline every invite
#                     GameMaster - only accounts at game master level or above
#                     Peer       - game masters, and players within 5 levels of her;
#                                  when both are at the top level, within 15 average
#                                  equipped item levels instead
#                     Anyone     - every player the server lets invite her
#
#                     An unknown value is logged at startup and treated as Nobody.
#

Playerbots.InvitePolicy = GameMaster

#
#    Playerbots.Gear.UpgradeMarginPct
#        Description: How much better, in percent, a piece of gear must score by her stat
#                     weights before a bot takes off what she wears for it. She looks
#                     through her bags when an item reaches them, when she gains a level,
#                     and when her specialization changes, and puts on one piece at a time
#                     with the same equip click a player makes, out of a fight. An empty
#                     slot is always filled. At retail stat budgets 1 is about one item
#                     level. A bigger number means she changes gear less often. What she
#                     takes off always scores lower than what she put on, so she never
#                     swaps back. Read at startup.
#        Default:     1
#

Playerbots.Gear.UpgradeMarginPct = 1

#
#    Playerbots.Gear.Weights.<specialization id>
#        Description: Changes what each stat is worth to bots of one specialization when
#                     they compare gear. The module brings a starting table for every
#                     specialization; a key here changes only the stats it names, and
#                     every other stat keeps the module's number. The main stat of a
#                     specialization is worth 1 in the module's table. Specializations the
#                     module has no row for (the one every class has before it picks one)
#                     start from their main stat, 0.4 for each secondary stat, and weapon
#                     damage for strength and agility users. Read at startup; each key
#                     read is written to Playerbots.log, and a key that cannot be read is
#                     logged and not used.
#
#                     Stats: Strength, Agility, Intellect, Stamina, CriticalStrike, Haste,
#                     Mastery, Versatility, Leech, Avoidance, Speed, Armor, WeaponDps.
#                     Short names work too: Str, Agi, Int, Sta, Crit, Mast, Vers, Dps.
#                     Armor is the armor on the item; WeaponDps is the weapon's damage
#                     per second.
#
#                     Specialization ids:
#                       Warrior 71 Arms, 72 Fury, 73 Protection
#                       Paladin 65 Holy, 66 Protection, 70 Retribution
#                       Hunter 253 Beast Mastery, 254 Marksmanship, 255 Survival
#                       Rogue 259 Assassination, 260 Outlaw, 261 Subtlety
#                       Priest 256 Discipline, 257 Holy, 258 Shadow
#                       Death Knight 250 Blood, 251 Frost, 252 Unholy
#                       Shaman 262 Elemental, 263 Enhancement, 264 Restoration
#                       Mage 62 Arcane, 63 Fire, 64 Frost
#                       Warlock 265 Affliction, 266 Demonology, 267 Destruction
#                       Monk 268 Brewmaster, 269 Windwalker, 270 Mistweaver
#                       Druid 102 Balance, 103 Feral, 104 Guardian, 105 Restoration
#                       Demon Hunter 577 Havoc, 581 Vengeance
#                       Evoker 1467 Devastation, 1468 Preservation, 1473 Augmentation
#        Default:     none (the module's table)
#
#        Example:     Playerbots.Gear.Weights.72 = "Haste=0.6, Mastery=0.3"
#                     Playerbots.Gear.Weights.63 = "Crit=0.5, Stamina=0.1"
#

#
#    Playerbots.LogDetail
#        Description: Bot character names, separated by commas, that write every
#                     step to Playerbots.log: each walking heartbeat, each packet
#                     she queues, each look around a lip. Every other bot writes
#                     only what she decides and what goes wrong, so a big
#                     population does not fill the disk. Names are not case
#                     sensitive. * means every bot. Read at startup.
#        Default:     "" (no bot writes step lines)
#
#                     Example: "Sora,Opai"
#

Playerbots.LogDetail = ""

#
#    Playerbots.MapThreadBrains
#        Description: Where a bot's brain runs while she stands on a map. With 1,
#                     each map's own update thread runs the brains of the bots on
#                     it, so bots on different maps think at the same time. With 0,
#                     every brain runs one after another on the world thread after
#                     the maps have updated. How a bot plays is the same either
#                     way. Only gains anything with MapUpdate.Threads above 1 and
#                     bots on more than one map. Read at startup.
#        Default:     0 (world thread)
#
#                     1 - map threads
#                     0 - world thread
#

Playerbots.MapThreadBrains = 0

#
#    Playerbots.Bridge.Enable
#        Description: Listen on 127.0.0.1 for the separate playerbots.exe
#                     coordinator while using Automatic login mode. That bridge
#                     remains read-only. Coordinator login mode always starts the
#                     bridge because playerbots.exe owns the request to log in.
#        Default:     0 (disabled)
#
#                     1 - enabled
#                     0 - disabled
#

Playerbots.Bridge.Enable = 0

#
#    Playerbots.Bridge.Port
#        Description: Loopback TCP port used by playerbots.exe.
#        Default:     3444
#

Playerbots.Bridge.Port = 3444

#
#    Appender.Playerbots
#        Description: File for module.playerbots log lines. Lives under LogsDir
#                     next to Server.log. Type 2 = file, level 3 = Info, flags 3 =
#                     timestamp and log level on each line, mode a = append.
#                     Does not replace Appender.Console. Do not put this in
#                     worldserver.conf; Log::Initialize reads every Appender.*
#                     key after module conf is loaded.
#        Default:     2,3,3,Playerbots.log,a
#

Appender.Playerbots = 2,3,3,Playerbots.log,a

#
#    Logger.module.playerbots
#        Description: What the module already logs as "module.playerbots".
#                     Level 3 = Info. Appender list is Console (the existing
#                     worldserver terminal) and Playerbots (the file above).
#                     Lines do not go to Server.log unless you add Server here.
#        Default:     3,Console Playerbots
#

Logger.module.playerbots = 3,Console Playerbots
